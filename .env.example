# Copy this file to .env and fill in your key.

# OpenRouter: one key for every model OpenRouter hosts. This is all you need.
OPENROUTER_API_KEY=

# Optional: skip the model menu by always using one model (an ID from `npm run list-models`)
# AI_MODEL=provider/model-name

# Optional: reasoning effort (low / medium / high) for models that support it
# AI_EFFORT=low

# Optional: neutral / aggressive / passive / pro
# AI_PLAYSTYLE=neutral

# ---------------------------------------------------------------------------
# Not needed if you use OpenRouter. Only for calling a provider directly:
# set AI_PROVIDER to Anthropic, OpenAI, Google or OpenAICompatible, plus its key.
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLEAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=

# Optional: path to Chrome/Chromium if it is not found automatically
# CHROME_PATH=
