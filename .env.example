# Copy this file to .env and fill in the key(s) for the provider(s) you use.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLEAI_API_KEY=

# For provider "OpenAICompatible" (OpenRouter, xAI, DeepSeek, Ollama, LM Studio, ...)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Optional overrides for app/configs/ai-config.json (handy for switching models without editing JSON)
# AI_PROVIDER=Anthropic
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# AI_PLAYSTYLE=neutral

# Optional: path to Chrome/Chromium if it is not found automatically
# CHROME_PATH=
